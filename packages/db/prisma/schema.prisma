// Schema Prisma - Plataforma Residencia Med
// Doc: docs/DATA-MODEL.md
// ADR multi-tenant: docs/adr/0004-multi-tenant-strategy.md

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// ==================== ENUMS ====================

enum TipoProva {
  R1
  R3
  ACESSO_DIRETO
  REVALIDACAO
}

enum Dificuldade {
  FACIL
  MEDIO
  DIFICIL
  MUITO_DIFICIL
}

enum FonteGuideline {
  SBP // Soc Bras Pediatria
  SBC // Soc Bras Cardiologia
  SBI // Soc Bras Infectologia
  SBR // Soc Bras Reumatologia
  SBOT // Soc Bras Ortopedia
  FEBRASGO
  SBN // Nefrologia
  SBPT // Pneumologia
  SBED // Endocrinologia
  MS // Ministerio da Saude
  ANVISA
  NICE
  WHO
  UPTODATE
  HARRISON
  CECIL
  NELSON
  OUTRO
}

enum Confianca {
  CHUTE
  INCERTO
  CONFIANTE
  NAO_SEI
}

enum MotivoErro {
  FALTA_CONHECIMENTO // nunca estudei / não sabia
  CONCEITO_ERRADO // achava que sabia (falsa compreensão)
  LEITURA_ENUNCIADO // li errado, pulei detalhe
  PEGADINHA // caí no distrator
  ESQUECIMENTO // sabia e esqueci
  DESATENCAO // marquei errado / cansaço
  OUTRO
}

enum TipoSessao {
  ESTUDO
  SIMULADO
  REVISAO
  LIVRE
}

enum TipoBloco {
  TEORIA
  QUESTOES
  REVISAO
  SIMULADO
}

enum StatusBloco {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  PULADO
}

enum PlanoUsuario {
  FREE
  PRO
  PREMIUM
}

enum PlanoOrg {
  STARTER
  GROWTH
  ENTERPRISE
}

enum StatusAssinatura {
  ATIVA
  TRIAL
  CANCELADA
  INADIMPLENTE
  EXPIRADA
}

enum PapelOrg {
  ADMIN
  MEMBRO
}

/// Fase da jornada do candidato dentro do ciclo anual.
/// EXTENSIVO = construção de base ao longo do ano.
/// RETA_FINAL = sprint pré-prova.
enum FaseJornada {
  EXTENSIVO
  RETA_FINAL
}

/// Classificação metodológica (clínica) da atividade de estudo.
/// Camada semântica sobre TipoSessao/TipoBloco funcionais; opcional.
/// ANAMNESE   = primeiro contato com conteúdo novo.
/// EXAME      = revisão espaçada ativa.
/// HIPOTESE   = simulado de antecipação (testar o que o candidato acha que vai cair).
/// CONDUTA    = fechamento/consolidação final no pré-prova.
/// PRONTUARIO = registro histórico de erros para consulta.
enum TipoAtividadeMetodo {
  ANAMNESE
  EXAME
  HIPOTESE
  CONDUTA
  PRONTUARIO
}

/// Cinturões de gamificação em ordem crescente. Faixas de XP calculadas
/// em packages/core/src/gamificacao.ts (não dependem do schema).
enum Cinturao {
  BRONZE
  PRATA
  OURO
  ESMERALDA
  PLATINA
  DIAMANTE
}

/// Perfil psicológico do candidato — 4 dimensões independentes.
/// Equivalente clínico ao LAPE do IPM, com nomes próprios.
enum PerfilDisc {
  ANALISTA
  COMUNICADOR
  EXECUTOR
  CONCILIADOR
}

enum PerfilSocioemocional {
  TAREFAS
  PESSOAS
  IDEIAS
  SISTEMAS
}

enum PerfilProcrastinacao {
  LEVE
  MODERADA
  SEVERA
}

enum PerfilMemoria {
  BAIXA
  MEDIA
  ACIMA_DA_MEDIA
  ALTA
}

/// Tipo do vídeo dentro de uma aula.
/// BASE        = aula principal, cobertura essencial do tema.
/// APROFUNDADA = aula adicional, aprofundamento opcional.
enum TipoVideoAula {
  BASE
  APROFUNDADA
}

/// Tipo do material complementar de uma aula (PDF, slide, etc).
enum TipoMaterialAula {
  MAPA_MENTAL
  APOSTILA
  RESUMO_ESTRATEGICO
  SLIDE_AULA
  OUTRO
}

/// Categoria de um post na comunidade.
enum CategoriaPost {
  DISCUSSAO
  DUVIDA
  DICA
  DESABAFO
}

/// Status do ticket de suporte.
enum StatusTicket {
  ABERTO
  EM_ANDAMENTO
  RESOLVIDO
  FECHADO
}

// ==================== USUARIO ====================

model User {
  id                  String        @id @default(cuid())
  authId              String        @unique // Supabase auth.users.id (UUID)
  email               String        @unique
  name                String?
  avatarUrl           String?

  // Metas
  metaResidencia      String? // codigo da banca alvo
  bancasAlvo          String[]      @default([]) // multi-banca
  dataProva           DateTime?
  cargaHorariaSemanal Int? // horas por semana
  faseJornada         FaseJornada   @default(EXTENSIVO)

  // Perfil estendido (contato / endereço)
  cpf                 String?
  whatsapp            String?
  instagram           String?
  tiktok              String?
  cep                 String?
  cidade              String?
  uf                  String?
  rua                 String?
  numero              String?
  bairro              String?
  complemento         String?

  // Multi-tenant
  organizationId      String?
  papelOrg            PapelOrg?
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Quotas IA
  creditosUsadosMes   Int           @default(0)
  creditosResetEm     DateTime?

  // Relacoes
  respostas           Resposta[]
  sessoes             Sessao[]
  planoEstudo         PlanoEstudo?
  itensRevisao        ItemRevisao[]
  assinatura          Assinatura?
  llmCalls            LLMCall[]
  conversasMentor     ConversaMentor[]
  submissoes          SubmissaoQuestao[]
  participacoesLive   ParticipanteLive[]
  proficiencia        Proficiencia?
  notificacoes        Notificacao[]
  pushSubscriptions   PushSubscription[]
  registrosErro       RegistroErro[]
  decks               Deck[]
  flashcards          Flashcard[]
  processosSeletivos  ProcessoSeletivo[]
  nivel               Nivel?
  perfilCandidato     PerfilCandidato?
  progressoAulas      ProgressoAula[]
  postsComunidade     PostComunidade[]
  comentariosComunidade ComentarioComunidade[]
  reportesComunidade  ReporteComunidade[]
  tickets             Ticket[]
  respostasTicket     RespostaTicket[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([authId])
  @@index([organizationId])
  @@index([email])
}

model Organization {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  authOrgId     String?         @unique // ID externo do provedor de auth (opcional)
  plano         PlanoOrg        @default(STARTER)
  seats         Int             @default(1)
  users         User[]
  assinatura    AssinaturaOrg?
  convites      ConviteOrg[]
  apiKeys       ApiKey[]
  simuladosLive SimuladoLive[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ConviteOrg {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  papel          PapelOrg     @default(MEMBRO)
  token          String       @unique
  convidadoPor   String // userId
  aceitoEm       DateTime?
  aceitoPor      String?
  revogadoEm     DateTime?
  expiraEm       DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
}

// ==================== API B2B ====================

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nome           String
  hash           String       @unique // sha256 da chave (nunca armazenar plaintext)
  prefixo        String // primeiros 8 chars, mostrados na listagem
  scopes         String[]     @default(["read"])
  ultimoUsoEm    DateTime?
  expiraEm       DateTime?
  revogadaEm     DateTime?
  criadoPor      String // userId
  usos           ApiKeyUso[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([hash])
}

model ApiKeyUso {
  id        String   @id @default(cuid())
  apiKeyId  String
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  rota      String
  status    Int
  latenciaMs Int
  createdAt DateTime @default(now())

  @@index([apiKeyId, createdAt])
}

// ==================== CONTRIBUICAO COLABORATIVA ====================

enum StatusSubmissao {
  PENDENTE_IA
  REJEITADA_IA
  PENDENTE_REVISAO
  APROVADA
  REJEITADA
}

model SubmissaoQuestao {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bancaId           String
  banca             Banca           @relation(fields: [bancaId], references: [id], onDelete: Restrict)
  ano               Int
  enunciado         String          @db.Text
  enunciadoVignette String?         @db.Text
  alternativasJson  Json // [{letra, texto, correta, explicacao?}]
  gabaritoLetra     String
  fonteUrl          String?
  comentario        String?         @db.Text

  status            StatusSubmissao @default(PENDENTE_IA)
  scoreIA           Float?
  motivoIA          String?         @db.Text
  questaoCriadaId   String?         @unique
  revisadaPor       String?
  revisadaEm        DateTime?
  motivoRejeicao    String?         @db.Text

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ==================== MINHAS PROVAS ====================

/// Processo seletivo que o candidato acompanha (edital, inscricao, logistica, prova, resultado).
/// Nao confundir com `Prova`, que e a prova importada com questoes.
/// Status (aguardando edital, inscricoes abertas...) e derivado em packages/core/src/minhas-provas.ts.
model ProcessoSeletivo {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  instituicao         String // "HCPA", "ENARE", "USP" (texto livre)
  bancaId             String? // vinculo opcional a Banca cadastrada
  banca               Banca?    @relation(fields: [bancaId], references: [id], onDelete: SetNull)
  especialidade       String // especialidade da residencia ("Cirurgia Geral")
  numeroInscricao     String?

  editalPublicado     Boolean   @default(false)
  linkEdital          String?
  inscricaoFeita      Boolean   @default(false)
  inscricaoPaga       Boolean   @default(false)
  taxaInscricaoCentavos Int?
  logisticaOrganizada Boolean   @default(false)
  cidadeProva         String?

  // Datas de calendario (sem hora/fuso)
  inicioInscricoes    DateTime? @db.Date
  fimInscricoes       DateTime? @db.Date
  dataProva           DateTime? @db.Date

  provaRealizada      Boolean   @default(false)
  acertos             Int?
  totalQuestoes       Int?
  observacoes         String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, dataProva])
  @@index([bancaId])
}

// ==================== GAMIFICACAO E PERFIL ====================

/// Nível de gamificação do candidato. XP é recalculado on-demand a partir
/// das respostas/revisões/sessões; esta tabela só persiste o estado atual
/// (cinturão + xp cacheado) para o dashboard não ter que agregar toda vez.
model Nivel {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cinturao     Cinturao @default(BRONZE)
  xp           Int      @default(0)
  atualizadoEm DateTime @updatedAt
}

/// Perfil psicológico do candidato — 4 dimensões, respondidas no onboarding.
/// Equivalente clínico ao LAPE do IPM com nomes próprios.
model PerfilCandidato {
  id             String                @id @default(cuid())
  userId         String                @unique
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  disc           PerfilDisc?
  socioemocional PerfilSocioemocional?
  procrastinacao PerfilProcrastinacao?
  memoria        PerfilMemoria?
  concluidoEm    DateTime?
  atualizadoEm   DateTime              @updatedAt
}

// ==================== VIDEO-AULAS (LMS) ====================
// Hierarquia: GrandeArea → Disciplina → Aula → VideoAula / MaterialAula
// Progresso por aula registrado em ProgressoAula.

model GrandeArea {
  id          String       @id @default(cuid())
  slug        String       @unique
  nome        String
  descricao   String?      @db.Text
  capaUrl     String?
  corTema     String?      // hex opcional para colorir cards
  fase        FaseJornada  @default(EXTENSIVO)
  ordem       Int          @default(0)
  publicado   Boolean      @default(false)
  disciplinas Disciplina[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([fase, publicado, ordem])
}

model Disciplina {
  id            String     @id @default(cuid())
  grandeAreaId  String
  grandeArea    GrandeArea @relation(fields: [grandeAreaId], references: [id], onDelete: Cascade)
  slug          String
  nome          String
  codigo        String?    // ex: "PREV 8"
  ordem         Int        @default(0)
  aulas         Aula[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([grandeAreaId, slug])
  @@index([grandeAreaId, ordem])
}

model Aula {
  id            String          @id @default(cuid())
  disciplinaId  String
  disciplina    Disciplina      @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  slug          String
  titulo        String
  descricao     String?         @db.Text
  ordem         Int             @default(0)
  videos        VideoAula[]
  materiais     MaterialAula[]
  progresso     ProgressoAula[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([disciplinaId, slug])
  @@index([disciplinaId, ordem])
}

/// Vídeo da aula. `provider` + `providerId` identificam onde está o asset
/// (Mux é o default — providerId é o Mux Playback ID). Trocar para outro
/// provider (Cloudflare Stream, self-hosted) é só mudar provider+id.
model VideoAula {
  id           String        @id @default(cuid())
  aulaId       String
  aula         Aula          @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  tipo         TipoVideoAula
  titulo       String
  duracaoS     Int           @default(0)
  provider     String        @default("mux") // "mux" | "cloudflare-stream" | "self-hosted"
  providerId   String        // Mux Playback ID / Cloudflare UID / URL
  thumbUrl     String?
  apresentador String?
  createdAt    DateTime      @default(now())

  @@index([aulaId, tipo])
}

model MaterialAula {
  id           String           @id @default(cuid())
  aulaId       String
  aula         Aula             @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  tipo         TipoMaterialAula
  titulo       String
  url          String           // CDN own-domain ou S3/R2
  tamanhoBytes Int?
  createdAt    DateTime         @default(now())

  @@index([aulaId])
}

model ProgressoAula {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aulaId          String
  aula            Aula      @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  concluida       Boolean   @default(false)
  concluidaEm     DateTime?
  tempoAssistidoS Int       @default(0)
  atualizadoEm    DateTime  @updatedAt

  @@unique([userId, aulaId])
  @@index([userId, concluida])
}

// ==================== COMUNIDADE E SUPORTE ====================

model PostComunidade {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoria   CategoriaPost          @default(DISCUSSAO)
  titulo      String
  corpo       String                 @db.Text
  ocultoEm    DateTime? // soft-hide via moderação; invisível pra usuários comuns
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  comentarios ComentarioComunidade[]
  reportes    ReporteComunidade[]

  @@index([createdAt])
  @@index([categoria, createdAt])
  @@index([userId])
  @@index([ocultoEm])
}

model ComentarioComunidade {
  id        String              @id @default(cuid())
  postId    String
  post      PostComunidade      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  corpo     String              @db.Text
  ocultoEm  DateTime?
  createdAt DateTime            @default(now())
  reportes  ReporteComunidade[]

  @@index([postId, createdAt])
}

enum MotivoReporte {
  SPAM
  OFENSIVO
  FORA_DO_TEMA
  INFO_INCORRETA
  OUTRO
}

enum StatusReporteComunidade {
  PENDENTE
  RESOLVIDO_OCULTO
  RESOLVIDO_MANTIDO
}

model ReporteComunidade {
  id            String                 @id @default(cuid())
  userId        String // quem denunciou
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId        String?
  post          PostComunidade?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comentarioId  String?
  comentario    ComentarioComunidade?  @relation(fields: [comentarioId], references: [id], onDelete: Cascade)
  motivo        MotivoReporte
  detalhes      String?                @db.Text
  status        StatusReporteComunidade @default(PENDENTE)
  resolvidoEm   DateTime?
  resolvidoPor  String?
  createdAt     DateTime              @default(now())

  @@index([status, createdAt])
  @@index([postId])
  @@index([comentarioId])
}

model Ticket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo    String
  corpo     String           @db.Text
  categoria String? // texto livre curto (ex: "cobrança", "bug", "sugestão")
  status    StatusTicket     @default(ABERTO)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  respostas RespostaTicket[]

  @@index([userId, status])
  @@index([status, createdAt])
}

model RespostaTicket {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  corpo     String   @db.Text
  deEquipe  Boolean  @default(false) // true se foi admin/suporte respondendo
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// ==================== CONTEUDO ====================

model Banca {
  id          String              @id @default(cuid())
  codigo      String              @unique // "AMRIGS", "ENARE"
  nome        String
  estado      String?
  descricao   String?
  url         String?
  cor         String? // brand color
  prioridade  Int                 @default(0) // ordenacao na UI
  provas      Prova[]
  questoes    Questao[]
  analises    AnaliseIncidencia[]
  submissoes  SubmissaoQuestao[]
  simuladosLive SimuladoLive[]
  processosSeletivos ProcessoSeletivo[]
  createdAt   DateTime            @default(now())

  @@index([codigo])
}

model Especialidade {
  id        String  @id @default(cuid())
  codigo    String  @unique
  nome      String
  cor       String?
  icone     String? // nome do icone Lucide
  ordem     Int     @default(0)
  temas     Tema[]
}

model Tema {
  id              String              @id @default(cuid())
  codigo          String              @unique
  nome            String
  especialidadeId String
  especialidade   Especialidade       @relation(fields: [especialidadeId], references: [id], onDelete: Cascade)

  // Hierarquia
  parentId        String?
  parent          Tema?               @relation("TemaHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  filhos          Tema[]              @relation("TemaHierarchy")
  profundidade    Int                 @default(0) // 0 = root, max 3

  questoes        QuestaoTema[]
  guidelines      GuidelineTema[]
  blocosEstudo   BlocoEstudo[]
  analises        AnaliseIncidencia[]

  @@unique([nome, especialidadeId, parentId])
  @@index([especialidadeId])
  @@index([parentId])
}

model Prova {
  id        String    @id @default(cuid())
  bancaId   String
  banca     Banca     @relation(fields: [bancaId], references: [id], onDelete: Cascade)
  ano       Int
  tipo      TipoProva @default(R1)
  titulo    String?
  fonte     String? // url do PDF original
  questoes  Questao[]
  importadaEm DateTime @default(now())

  @@unique([bancaId, ano, tipo])
  @@index([ano])
}

model Questao {
  id                String              @id @default(cuid())
  bancaId           String
  banca             Banca               @relation(fields: [bancaId], references: [id], onDelete: Restrict)
  provaId           String?
  prova             Prova?              @relation(fields: [provaId], references: [id], onDelete: SetNull)

  // Conteudo
  enunciado         String              @db.Text
  enunciadoVignette String?             @db.Text // caso clinico (opcional)
  alternativas      Alternativa[]
  gabaritoLetra     String // 'A','B','C','D','E'
  explicacao        String              @db.Text
  explicacaoMd      String              @db.Text
  dificuldade       Dificuldade         @default(MEDIO)

  // Metadata
  ano               Int
  numeroOriginal    Int?
  fonte             String?
  hash              String              @unique // sha256 do enunciado normalizado

  // IA
  embedding         Unsupported("vector(1536)")?
  geradaPorIA       Boolean             @default(false)

  // Comentario gerado por IA (rotulado na UI ate revisao humana).
  // JSON no formato ComentarioQuestao de packages/ai/funcoes/comentar-questao.
  comentarioIa         Json?
  comentarioIaModelo   String?
  comentarioIaVersao   String?
  comentarioIaEm       DateTime?
  comentarioIaRevisado Boolean          @default(false)
  // IA discordou do gabarito oficial: exibir alerta, nunca trocar o gabarito sozinha
  gabaritoContestadoIa Boolean          @default(false)
  questaoOriginalId String?
  questaoOriginal   Questao?            @relation("VariacoesIA", fields: [questaoOriginalId], references: [id], onDelete: SetNull)
  variacoes         Questao[]           @relation("VariacoesIA")

  // Estado
  publicada         Boolean             @default(true)
  reportes          Int                 @default(0) // contagem de erros reportados

  // Relacoes
  temas             QuestaoTema[]
  guidelines        QuestaoGuideline[]
  respostas         Resposta[]
  itensRevisao      ItemRevisao[]
  registrosErro     RegistroErro[]
  flashcards        Flashcard[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([bancaId, ano])
  @@index([dificuldade])
  @@index([publicada])
  @@index([provaId])
}

model Alternativa {
  id              String  @id @default(cuid())
  questaoId       String
  questao         Questao @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  letra           String // 'A','B','C','D','E'
  texto           String  @db.Text
  correta         Boolean @default(false)
  explicacaoErro  String? @db.Text // por que essa alternativa esta errada
  ordem           Int     @default(0)

  respostas       Resposta[]

  @@unique([questaoId, letra])
  @@index([questaoId])
}

enum OrigemClassificacao {
  MANUAL
  PARSER
  IA
}

model QuestaoTema {
  questaoId String
  temaId    String
  peso      Float   @default(1.0) // primary = 1.0, secondary = 0.3-0.5
  primario  Boolean @default(false)
  origem    OrigemClassificacao @default(MANUAL)
  confianca Float?  // 0-1, quando classificada por IA
  questao   Questao @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  tema      Tema    @relation(fields: [temaId], references: [id], onDelete: Cascade)

  @@id([questaoId, temaId])
  @@index([temaId])
  @@index([questaoId])
}

model Guideline {
  id           String                       @id @default(cuid())
  fonte        FonteGuideline
  titulo       String
  ano          Int
  url          String?
  resumo       String                       @db.Text
  conteudo     String?                      @db.Text
  embedding    Unsupported("vector(1536)")?

  temas        GuidelineTema[]
  questoes     QuestaoGuideline[]

  createdAt    DateTime                     @default(now())

  @@index([fonte, ano])
}

model GuidelineTema {
  guidelineId String
  temaId      String
  guideline   Guideline @relation(fields: [guidelineId], references: [id], onDelete: Cascade)
  tema        Tema      @relation(fields: [temaId], references: [id], onDelete: Cascade)

  @@id([guidelineId, temaId])
}

model QuestaoGuideline {
  questaoId   String
  guidelineId String
  trecho      String?   @db.Text
  questao     Questao   @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  guideline   Guideline @relation(fields: [guidelineId], references: [id], onDelete: Cascade)

  @@id([questaoId, guidelineId])
}

// ==================== ATIVIDADE ====================

model Resposta {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questaoId        String
  questao          Questao      @relation(fields: [questaoId], references: [id], onDelete: Restrict)
  alternativaId    String?
  alternativa      Alternativa? @relation(fields: [alternativaId], references: [id], onDelete: SetNull)
  alternativaLetra String? // backup
  correta          Boolean
  tempoSegundos    Int
  confianca        Confianca?
  modoRevisao      Boolean      @default(false)

  sessaoId         String?
  sessao           Sessao?      @relation(fields: [sessaoId], references: [id], onDelete: SetNull)

  createdAt        DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([userId, questaoId])
  @@index([questaoId])
  @@index([sessaoId])
}

model Sessao {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo                TipoSessao
  tipoAtividadeMetodo TipoAtividadeMetodo? // classificação metodológica (opcional)
  bancaId             String?
  configuracao        Json // filtros, n. questoes, tempo, etc.
  iniciadaEm          DateTime             @default(now())
  finalizadaEm        DateTime?
  acertos             Int                  @default(0)
  erros               Int                  @default(0)
  pulos               Int                  @default(0)
  tempoTotal          Int                  @default(0)
  respostas           Resposta[]

  @@index([userId, iniciadaEm])
  @@index([tipo])
  @@index([tipoAtividadeMetodo])
}

model PlanoEstudo {
  id                  String        @id @default(cuid())
  userId              String        @unique
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bancaAlvo           String
  dataProva           DateTime
  cargaHorariaSemanal Int
  geradoEm            DateTime      @default(now())
  ultimaRevisaoEm     DateTime?
  narrativa           String?       @db.Text
  blocos              BlocoEstudo[]
}

model BlocoEstudo {
  id                  String               @id @default(cuid())
  planoId             String
  plano               PlanoEstudo          @relation(fields: [planoId], references: [id], onDelete: Cascade)
  semana              Int
  diaSemana           Int // 0 = domingo, 6 = sabado
  ordem               Int                  @default(0)
  duracaoMin          Int
  tipo                TipoBloco
  tipoAtividadeMetodo TipoAtividadeMetodo? // classificação metodológica (opcional)
  temaId              String?
  tema                Tema?                @relation(fields: [temaId], references: [id], onDelete: SetNull)
  titulo              String
  descricao           String?              @db.Text
  status              StatusBloco          @default(PENDENTE)
  concluidoEm         DateTime?

  @@index([planoId, semana, diaSemana])
  @@index([tipoAtividadeMetodo])
}

model ItemRevisao {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questaoId       String
  questao         Questao  @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  // Estado SM-2 modificado
  intervalo       Int      @default(1) // dias
  repeticoes      Int      @default(0)
  fatorFacilidade Float    @default(2.5)
  qualidade       Int? // 0-5 ultima revisao

  ultimaRevisao   DateTime?
  proximaRevisao  DateTime

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, questaoId])
  @@index([userId, proximaRevisao])
}

// ==================== COMPUTADO ====================

model AnaliseIncidencia {
  id            String   @id @default(cuid())
  bancaId       String
  banca         Banca    @relation(fields: [bancaId], references: [id], onDelete: Cascade)
  temaId        String
  tema          Tema     @relation(fields: [temaId], references: [id], onDelete: Cascade)
  janelaAnos    Int // 5, 10
  totalQuestoes Int
  porcentagem   Float
  tendencia     Float    @default(0) // delta vs janela anterior
  computadoEm   DateTime @default(now())

  @@unique([bancaId, temaId, janelaAnos])
  @@index([bancaId, porcentagem])
  @@index([bancaId, janelaAnos])
}

model LLMCall {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  funcao      String // 'explicarErro', 'gerarQuestao', etc
  modelo      String // 'claude-sonnet-4-6', 'gpt-4o'
  versaoPrompt String
  cacheKey    String   @unique
  cacheHit    Boolean  @default(false)

  inputTokens   Int
  outputTokens  Int
  latenciaMs    Int
  custoUsd      Float
  status        String // 'sucesso', 'erro_provider', 'erro_validacao'
  erro          String?  @db.Text

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([funcao, createdAt])
  @@index([cacheKey])
}

// ==================== SAAS ====================

model Assinatura {
  id                   String           @id @default(cuid())
  userId               String           @unique
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String           @unique
  stripeSubscriptionId String?          @unique
  stripePriceId        String?
  plano                PlanoUsuario     @default(FREE)
  status               StatusAssinatura @default(TRIAL)
  iniciadaEm           DateTime?
  validaAte            DateTime?
  trialAte             DateTime?
  canceladaEm          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([stripeCustomerId])
  @@index([status])
}

model AssinaturaOrg {
  id                   String           @id @default(cuid())
  organizationId       String           @unique
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeCustomerId     String           @unique
  stripeSubscriptionId String?          @unique
  stripePriceId        String?
  plano                PlanoOrg         @default(STARTER)
  status               StatusAssinatura @default(TRIAL)
  seatsContratadas     Int              @default(1)
  iniciadaEm           DateTime?
  validaAte            DateTime?
  canceladaEm          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model EventoStripe {
  id          String   @id @default(cuid())
  stripeEventId String @unique
  tipo        String
  payload     Json
  processadoEm DateTime?
  erro        String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([processadoEm])
}

// ==================== MENTOR IA ====================

enum PapelMensagem {
  USUARIO
  ASSISTENTE
  SISTEMA
}

model ConversaMentor {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo      String
  contextoJson Json? // snapshot do contexto do usuario no inicio
  mensagens   MensagemMentor[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, updatedAt])
}

model MensagemMentor {
  id           String         @id @default(cuid())
  conversaId   String
  conversa     ConversaMentor @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  papel        PapelMensagem
  conteudo     String         @db.Text
  inputTokens  Int            @default(0)
  outputTokens Int            @default(0)
  custoUsd     Float          @default(0)
  createdAt    DateTime       @default(now())

  @@index([conversaId, createdAt])
}


// ==================== SIMULADO LIVE ====================

enum StatusSimuladoLive {
  AGUARDANDO
  EM_ANDAMENTO
  ENCERRADO
}

model SimuladoLive {
  id              String              @id @default(cuid())
  codigo          String              @unique // 6 chars maiusculos para sala
  titulo          String
  bancaId         String?
  banca           Banca?              @relation(fields: [bancaId], references: [id], onDelete: SetNull)
  organizationId  String?
  organization    Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  criadoPor       String // userId
  numeroQuestoes  Int                 @default(20)
  tempoMinutos    Int                 @default(40)
  questaoIds      String[]            @default([])
  status          StatusSimuladoLive  @default(AGUARDANDO)
  iniciaEm        DateTime?
  encerraEm       DateTime?
  participantes   ParticipanteLive[]
  createdAt       DateTime            @default(now())

  @@index([codigo])
  @@index([organizationId])
  @@index([status])
}

model ParticipanteLive {
  id             String       @id @default(cuid())
  simuladoLiveId String
  simulado       SimuladoLive @relation(fields: [simuladoLiveId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  finalizadoEm   DateTime?
  acertos        Int          @default(0)
  erros          Int          @default(0)
  tempoTotal     Int          @default(0)
  respostasJson  Json?        // [{questaoId, alternativaLetra, correta, tempo}]

  @@unique([simuladoLiveId, userId])
  @@index([simuladoLiveId])
}

// ==================== PROFICIENCIA ====================

model Proficiencia {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scoreGlobal         Float    @default(0) // 0-100
  porEspecialidadeJson Json    @default("[]")
  totalRespostas      Int      @default(0)
  atualizadoEm        DateTime @default(now())

  @@index([userId])
}

// ==================== NOTIFICACOES IN-APP ====================

enum TipoNotificacao {
  REVISAO_VENCENDO
  PLANO_ATIVADO
  PLANO_CANCELADO
  PLANO_INADIMPLENTE
  CONVITE_ORG
  SIMULADO_LIVE_CONVITE
  CONTRIBUICAO_APROVADA
  CONTRIBUICAO_REJEITADA
  CONTRIBUICAO_VALIDADA_IA
  PROFICIENCIA_MARCO
  COMENTARIO_COMUNIDADE
  RESPOSTA_SUPORTE
  SISTEMA
}

model Notificacao {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      TipoNotificacao
  titulo    String
  conteudo  String?         @db.Text
  link      String?
  lidaEm    DateTime?
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([userId, lidaEm])
}

// ==================== WEB PUSH ====================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ==================== A/B TEST ====================

model Experimento {
  id            String                    @id @default(cuid())
  chave         String                    @unique
  nome          String
  descricao     String?                   @db.Text
  variantesJson Json // [{nome: 'A', peso: 50}, {nome: 'B', peso: 50}]
  ativo         Boolean                   @default(false)
  iniciadoEm    DateTime?
  encerradoEm   DateTime?
  atribuicoes   AtribuicaoExperimento[]
  eventos       EventoExperimento[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([ativo])
}

model AtribuicaoExperimento {
  id             String      @id @default(cuid())
  experimentoId  String
  experimento    Experimento @relation(fields: [experimentoId], references: [id], onDelete: Cascade)
  userId         String
  variante       String
  primeiraVisita DateTime    @default(now())

  @@unique([experimentoId, userId])
  @@index([experimentoId, variante])
}

model EventoExperimento {
  id            String      @id @default(cuid())
  experimentoId String
  experimento   Experimento @relation(fields: [experimentoId], references: [id], onDelete: Cascade)
  userId        String
  variante      String
  evento        String // 'view', 'click', 'conversion', etc
  metadataJson  Json?
  createdAt     DateTime    @default(now())

  @@index([experimentoId, evento, createdAt])
  @@index([experimentoId, userId])
}

// ==================== CADERNO DE ERROS ====================

/// Anotação do estudante sobre um erro. A lista de erros em si é derivada
/// das respostas; aqui fica só o que o estudante acrescenta (motivo, conceito,
/// anotação) e se considera o erro resolvido.
model RegistroErro {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  questaoId       String
  questao         Questao     @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  motivo          MotivoErro?
  conceitoCorreto String?     @db.Text
  anotacao        String?     @db.Text
  resolvido       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, questaoId])
  @@index([userId, motivo])
}

// ==================== FLASHCARDS (FSRS) ====================

enum EstadoFsrs {
  NOVO
  APRENDENDO
  REVISAO
  REAPRENDENDO
}

enum NotaFlashcard {
  ERREI
  DIFICIL
  BOM
  FACIL
}

enum OrigemFlashcard {
  MANUAL
  ERRO // criado a partir do caderno de erros
  IA // sugerido pelo comentário gerado por IA
}

model Deck {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String
  descricao String?
  cartoes   Flashcard[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, nome])
  @@index([userId])
}

/// Estado FSRS espelhado de ts-fsrs (packages/core/src/flashcards.ts).
model Flashcard {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId            String
  deck              Deck               @relation(fields: [deckId], references: [id], onDelete: Cascade)
  questaoId         String?
  questao           Questao?           @relation(fields: [questaoId], references: [id], onDelete: SetNull)
  frente            String             @db.Text
  verso             String             @db.Text
  origem            OrigemFlashcard    @default(MANUAL)
  suspenso          Boolean            @default(false)
  favorito          Boolean            @default(false)

  vencimento        DateTime
  estabilidade      Float
  dificuldade       Float
  diasDecorridos    Int
  diasAgendados     Int
  passosAprendizado Int
  repeticoes        Int
  lapsos            Int
  estado            EstadoFsrs
  ultimaRevisao     DateTime?

  revisoes          RevisaoFlashcard[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId, vencimento])
  @@index([deckId])
}

model RevisaoFlashcard {
  id          String        @id @default(cuid())
  flashcardId String
  flashcard   Flashcard     @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  userId      String
  nota        NotaFlashcard
  estadoAntes EstadoFsrs
  revisadoEm  DateTime      @default(now())

  @@index([userId, revisadoEm])
  @@index([flashcardId])
}
