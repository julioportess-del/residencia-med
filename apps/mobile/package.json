    "expo": "~52.0.20",
    "expo-constants": "~17.0.4",
    "expo-linking": "~7.0.4",
    "expo-notifications": "~0.29.11",
    "expo-router": "~4.0.14",
    "expo-secure-store": "~14.0.1",
    "expo-speech": "~13.0.1",
    "expo-status-bar": "~2.0.0",
