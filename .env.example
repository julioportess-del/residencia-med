# =============================================================
# Residencia Med - Variaveis de ambiente
# Copie para .env e preencha conforme necessario.
# Para teste local rápido, use os valores padrão de Postgres/Redis (docker-compose up -d).
# =============================================================

# --- Banco de dados (Postgres + pgvector) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/residencia_med?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/residencia_med?schema=public"

# --- Redis (cache + filas BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Anthropic Claude (LLM primario) ---
ANTHROPIC_API_KEY=""           # sk-ant-... (opcional em dev — explicações IA ficam offline)
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- OpenAI (embeddings) ---
OPENAI_API_KEY=""              # sk-... (opcional em dev)
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Supabase (auth) ---
NEXT_PUBLIC_SUPABASE_URL=""    # https://YOUR-PROJECT.supabase.co (opcional se DEV_USER_EMAIL setado)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""   # opcional, server-only

# --- Modo dev local: bypass de auth ---
# Setando DEV_USER_EMAIL você fica logado automaticamente como esse email,
# sem precisar configurar Supabase. NÃO usar em produção.
DEV_USER_EMAIL="dev@residencia-med.local"

# --- Stripe (billing) — opcional em dev ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_ANNUAL=""
STRIPE_PRICE_ORG_STARTER=""

# --- Admin ---
ADMIN_EMAILS="dev@residencia-med.local"

# --- Web Push (VAPID) ---
# Gerar uma vez com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@residencia-med.com"

# --- Email transacional (Resend) — opcional ---
RESEND_API_KEY=""
EMAIL_FROM="Residência Med <ola@residencia-med.com>"

# --- Observabilidade — opcional ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
AXIOM_TOKEN=""
AXIOM_DATASET="residencia-med"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Mobile (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""
# Opcional: forçar URL da API. Sem isso, Expo usa o IP do debugger.
# EXPO_PUBLIC_API_URL="https://app.residencia-med.com"

# ===== Escriba (dados clinicos isolados — schema `clinico`) =====
DATABASE_URL_CLINICO="postgresql://postgres:postgres@localhost:5432/residencia_med?schema=clinico"
DIRECT_URL_CLINICO="postgresql://postgres:postgres@localhost:5432/residencia_med?schema=clinico"
OPENAI_TRANSCRIBE_MODEL="whisper-1"
