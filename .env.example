# =============================================================
# Residencia Med - Variaveis de ambiente
# Copie para .env.local e preencha conforme necessario
# =============================================================

# --- Banco de dados (Postgres + pgvector) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/residencia_med?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/residencia_med?schema=public"

# --- Redis (cache + filas BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Anthropic Claude (LLM primario) ---
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- OpenAI (embeddings) ---
OPENAI_API_KEY="sk-..."
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/app"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# --- Stripe (billing) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PREMIUM_MONTHLY="price_..."
STRIPE_PRICE_ORG_STARTER="price_..."

# --- Observabilidade ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
AXIOM_TOKEN=""
AXIOM_DATASET="residencia-med"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
